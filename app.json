{
  "expo": {
    "name": "Wayback",
    "slug": "wayback",
    "scheme": "wayback",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0B",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wayback.app"
    },
    "android": {
      "package": "com.wayback.app",
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.ACTIVITY_RECOGNITION"],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Wayback uses your motion sensors to count steps and detect floor changes so it can guide you back to where you entered. Nothing leaves your phone."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0A0B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ]
  }
}
